{
  "rewrites": [
    {
      "source": "/p/:id",
      "destination": "/api/og?id=:id"
    }
  ],
  "headers": [
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
